{
  "pollIntervalMs": 60000,
  "backgroundSweepEvery": 5,
  "idleThresholdSeconds": 120,
  "saveScreenshotsLocally": false,
  "localScreenshotDirectory": "agent-screenshots",
  "serverUrl": "http://localhost:4000/api/activity",
  "agentToken": "change-me-shared-secret",

  "llm": {
    "baseUrl": "http://10.0.4.9:3838",
    "model": "google/gemma-4-26b-a4b",
    "jsonMode": false,
    "prefillJson": true,
    "systemPrompt": "You are a JSON-only classifier. You must respond with a single valid JSON object and nothing else — no markdown, no code fences, no explanation, no prose. Do not start your response with ```json or any other text. Output only the raw JSON object.",
    "maxTokens": 1200,
    "temperature": 0.2,
    "timeoutMs": 60000,
    "resizeWidth": 1280,
    "resizeHeight": 800,
    "maxCallsPerHour": 120,
    "cacheWindowSeconds": 60,
    "degradedAfterConsecutiveFailures": 2
  },

  "subjects": [
    "Math",
    "Science",
    "English",
    "Social Studies",
    "PE",
    "Foreign Language",
    "Art/Elective",
    "Independent Project"
  ],

  "ledger": {
    "dbPath": "ledger.db",
    "unitThresholdMinutes": 30,
    "dailyUnitGoal": 12,
    "maxUnitsPerSubject": 2,
    "quizMinPriorActiveMinutes": 8,
    "screenshotRetentionDays": 7
  },

  "peSchedule": {
    "windowStartHour": 15,
    "windowEndHour": 17,
    "byWeekday": {
      "1": 1,
      "2": 1,
      "3": 1,
      "4": 2,
      "5": 2
    }
  },

  "enforcement": {
    "mode": "observe",
    "fadeOutSeconds": 300,
    "fadeInSeconds": 300,
    "breakMinutes": 5,
    "distractionThreshold": 2,
    "degradedFadeSeconds": 60,
    "maxOpacity": 0.85,
    "offTaskMinutesBeforeBreak": 10,
    "overrideMinutes": 15,
    "parentPin": "change-me-pin"
  },

  "calendar": {
    "holidays": [],
    "summerStart": null,
    "summerEnd": null
  }
}
